# Dev-only overrides (runtime users set keys in Settings UI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional: GitHub token for question-bank push (fine-grained, contents:write on question-bank only)
GITHUB_TOKEN=
GITHUB_REPO=pizhyanov/cursor
GITHUB_QUESTION_BANK_PATH=InterviewRightHand/question-bank/inbox
